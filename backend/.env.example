# CoalTrade AI Backend Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coaltrade_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Secret (generate a strong random string)
JWT_SECRET=coaltrade_ai_jwt_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Python AI Model Flask API
AI_MODEL_URL=http://localhost:5001

# CORS Origin (frontend URL)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
